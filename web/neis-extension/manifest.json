{
  "manifest_version": 3,
  "name": "AI 서·논술형 NEIS 입력 도우미",
  "version": "1.2.0",
  "description": "NEIS 화면 오른쪽 진행 패널을 보며 학생별 성취수준 단계를 한 번에 안전하게 입력합니다.",
  "permissions": [
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://deepsky616.github.io/essay-grader/*",
    "https://*.neis.go.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://deepsky616.github.io/essay-grader/*"
      ],
      "js": [
        "webapp-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AI 서·논술형 NEIS 입력 도우미"
  }
}
